# XCAIL Industrial — variables de entorno
#
# El frontend NO necesita ninguna variable para correr en local (pnpm dev).
# El formulario de contacto le pega a /api/notify (Vercel Serverless Function),
# que en local no está disponible: probá el envío real en el preview de Vercel.
#
# Las siguientes variables se configuran en Vercel → Project Settings →
# Environment Variables (SIN prefijo VITE_: son solo del servidor).

# Requerida — key de resend.com/api-keys
RESEND_API_KEY=re_tu-clave-de-api

# Opcional — destinatario de las solicitudes. Default: contacto@xcailindustrial.com
# NOTIFY_EMAIL=contacto@xcailindustrial.com

# Opcional — remitente verificado en Resend.
# Default: noreply@mail.xcail.com (subdominio ya verificado).
# Cambiar cuando mail.xcailindustrial.com esté verificado en Resend.
# FROM_EMAIL=noreply@mail.xcail.com
